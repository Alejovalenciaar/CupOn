# =====================================================
# Variables de entorno para el proyecto Cupon
# Copia este archivo como .env y ajusta los valores
# NUNCA subas el archivo .env real (con valores reales) al repositorio
# =====================================================

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5433
POSTGRESS_DB_CUPON=cupon_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
# OBLIGATORIO: no tiene valor por defecto, la app no arranca sin esta variable.
# Genera un secreto propio, por ejemplo con: openssl rand -base64 32
JWT_SECRET_CUPON=changeme-generate-your-own-base64-secret-min-256-bits
JWT_EXPIRATION_CUPON=86400000
JWT_SECRET=changeme-generate-your-own-base64-secret-min-256-bits
JWT_EXPIRATION=86400000

# --- Frontend ---
# URL base del frontend, usada para construir el enlace de recuperación de contraseña
FRONTEND_URL=http://localhost:5173

# --- Email / SMTP (recuperación de contraseña) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
PASSWORD_RESET_EXPIRATION_MINUTES=30

# --- Chatbot RAG (Spring AI + Groq) ---
# OBLIGATORIO para el chatbot: genera tu clave en https://console.groq.com
# Nunca subas el valor real al repositorio
GROQ_API_KEY=gsk_your-own-key-here

# --- Cloudinary (imagenes) ---
CLOUDINARY_CLOUD_NAME=changeme
CLOUDINARY_API_KEY=changeme
CLOUDINARY_API_SECRET=changeme
CLOUDINARY_FOLDER=cupon
